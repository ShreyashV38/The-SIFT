# SIFT Platform — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Provisioning API
PROVISIONING_API_KEY=change-me-to-a-random-string
PROVISIONING_API_PORT=3000

# Magistrala
MAGISTRALA_URL=http://magistrala-things.platform.svc.cluster.local
MAGISTRALA_ADMIN_EMAIL=admin@sift.local
MAGISTRALA_ADMIN_PASSWORD=change-me

# ThingsBoard
TB_URL=http://thingsboard.observability.svc.cluster.local:8080
TB_ADMIN_EMAIL=tenant@thingsboard.org
TB_ADMIN_PASSWORD=change-me
TB_GATEWAY_TOKEN=change-me

# Home Assistant
HA_IMAGE_TAG=2025.1.0

# Domain (localtest.me resolves to 127.0.0.1)
DOMAIN=localtest.me

# JWT Secret (for session tokens)
JWT_SECRET=change-me-to-a-random-string

{
  "version": 1,
  "author": "CloudNest / The-SIFT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -60,
      "left": 150,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -40,
      "left": -80,
      "attrs": {
        "color": "green"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 20,
      "left": -100,
      "attrs": {
        "value": "220"
